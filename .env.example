# GCP 프로젝트 설정
# 다음 중 하나를 설정하세요
GOOGLE_CLOUD_PROJECT=your-project-id
# GCP_PROJECT=your-project-id
# GCLOUD_PROJECT=your-project-id

# CORS 설정 (프로덕션 환경에서는 반드시 설정)
# 쉼표로 구분하여 여러 도메인 허용 가능
# ALLOWED_ORIGINS=https://example.com,https://storage.googleapis.com
ALLOWED_ORIGINS=*

# 개발 환경 전용 - 기본 프로젝트 ID
# 프로덕션에서는 사용하지 마세요
# DEFAULT_PROJECT_ID=your-dev-project-id

# Cloud Storage 버킷 설정 (프론트엔드 배포용)
BUCKET_SUFFIX=cloud-architecture-frontend

# 배포 리전 (기본값: asia-northeast3)
# REGION=asia-northeast3

# Cloud Run 설정
# MAX_INSTANCES=10
# MIN_INSTANCES=0
# MEMORY=1Gi
# CPU=1
# TIMEOUT=300
